# Copy to .env for local development. .env is gitignored. Never commit real credentials.
# These defaults are for local development only and intentionally bind to loopback.

# ============ SOCKS5 PROXY ============
PROXY_ADDRESS=127.0.0.1
PROXY_PORT=1080
PROXY_MAX_CONNECTIONS=10000
PROXY_DIAL_TIMEOUT_MS=10000
PROXY_HANDSHAKE_TIMEOUT_MS=10000
PROXY_SHUTDOWN_GRACE_MS=5000
PROXY_IDLE_TIMEOUT_MS=0

# Phase 2 workloads and policy are configured primarily via YAML (configs/config.yml).
# Enable policy enforcement with:
POLICY_ENABLED=false
POLICY_ID=default
POLICY_VERSION=1
POLICY_DEFAULT_ACTION=deny

# Optional RFC 1929 username/password authentication.
# When enabled, both username and password are required or startup fails.
PROXY_AUTH_ENABLED=false
PROXY_AUTH_USERNAME=
PROXY_AUTH_PASSWORD=

# Exact IPs or CIDR ranges, comma-separated. Empty means allow all clients.
# Example: PROXY_IP_WHITELIST=127.0.0.1,10.0.0.0/8
PROXY_IP_WHITELIST=

# ============ ANALYTICS API ============
# Unauthenticated in Phase 1; keep loopback unless protected by the network boundary.
API_ADDRESS=127.0.0.1
API_PORT=8080
API_READ_TIMEOUT_MS=10000
API_WRITE_TIMEOUT_MS=10000
API_IDLE_TIMEOUT_MS=60000

# ============ PROMETHEUS METRICS ============
METRICS_ENABLED=true
METRICS_ADDRESS=127.0.0.1
METRICS_PORT=9090

# ============ DATABASE (REQUIRED) ============
DB_HOST=localhost
DB_PORT=5432
DB_USER=socks5
DB_PASSWORD=socks5_local_dev_password
DB_NAME=socks5_analytics
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT_MS=5000
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10

# ============ ANALYTICS PIPELINE (BEST-EFFORT) ============
PIPELINE_WORKERS=4
PIPELINE_BUFFER_SIZE=10000
PIPELINE_BATCH_SIZE=100
PIPELINE_FLUSH_INTERVAL_MS=5000
PIPELINE_MAX_RETRIES=3
PIPELINE_RETRY_BACKOFF_MS=200
PIPELINE_FLUSH_TIMEOUT_MS=5000

# ============ LOGGING ============
LOG_LEVEL=info
LOG_FORMAT=json

# ============ RATE LIMITING (PER SOURCE IP) ============
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPS=100
RATE_LIMIT_MAX_TRACKED_CLIENTS=100000

# ============ SHUTDOWN ============
SHUTDOWN_TIMEOUT_MS=15000

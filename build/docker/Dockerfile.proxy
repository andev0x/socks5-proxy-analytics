# Multi-stage build for Proxy
FROM golang:1.27.3-alpine AS builder

WORKDIR /app

# Install git and ca-certificates for building
RUN apk add --no-cache git ca-certificates

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the proxy binary with optimizations
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -a -installsuffix cgo -o proxy ./cmd/proxy/main.go

# Runtime image
FROM alpine:3.24

# Install ca-certificates and create non-root user
RUN apk --no-cache add ca-certificates && \
    addgroup -g 1000 -S appgroup && \
    adduser -u 1000 -S appuser -G appgroup

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/proxy .

# Change ownership to appuser
RUN chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

# SOCKS5 listener and Prometheus metrics endpoint.
EXPOSE 1080 9090

# Health check uses the metrics process health endpoint (metrics must remain enabled).
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:9090/healthz || exit 1

CMD ["./proxy"]
